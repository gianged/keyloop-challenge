POSTGRES_USER=keyloop
POSTGRES_PASSWORD=keyloop
POSTGRES_DB=keyloop

# local run outside compose (db published on 5432)
DATABASE_URL=postgres://keyloop:keyloop@localhost:5432/keyloop
BIND_ADDR=0.0.0.0:8080
DB_POOL_MAX=10
SLOT_STEP_MINUTES=30
LOCK_TIMEOUT_MS=2000
RUST_LOG=info,sqlx=warn
LOG_FORMAT=pretty
