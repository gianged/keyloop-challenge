    {
      "id": "JmmR_J27N2wx4ex75Es8o",
      "type": "text",
      "x": 294.04761904761904,
      "y": 203.85714285714283,
      "width": 714.1500244140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "SyFudptqBH7mzVaRaBQub",
        "PJA4jdRty1dtNYAuXH1eO"
      ],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1007192327,
      "version": 1558,
      "versionNonce": 1055399117,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532383662,
      "created": 1793267691247,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n- Customer books: vehicle, service type, dealership, time\n- System allocates a ServiceBay + qualified Technican for full the service\nduration\n- Customer can cancel\n- Browse open slots per dealership / service type /date\n- Clear response: appointment id, bay, technician, time",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n- Customer books: vehicle, service type, dealership, time\n- System allocates a ServiceBay + qualified Technican for full the service\nduration\n- Customer can cancel\n- Browse open slots per dealership / service type /date\n- Clear response: appointment id, bay, technician, time",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "W9RHpUEZ3njyhxyU4epJi",
      "type": "text",
      "x": 300.04761904761904,
      "y": 418.85714285714283,
      "width": 541.2666625976562,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "SyFudptqBH7mzVaRaBQub",
        "PJA4jdRty1dtNYAuXH1eO"
