    {
      "id": "IaaILLEpPHv1Bdys2FIyA",
      "type": "text",
      "x": 1184.5238095238094,
      "y": 252.97619047619048,
      "width": 562.4000244140625,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xf1fVWyXcBQ-yJJlKYV1S"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 219352723,
      "version": 1855,
      "versionNonce": 2110314339,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793540395868,
      "created": 1793348977271,
      "link": null,
      "locked": false,
      "text": "POST /api/v1/appointments -> Appointment\n    Header Idempotency-Key\n    Body { customer_id, vehicle_id, dealership_id,\n            service_type_id, time }\n    201 new\n    200 replay\n    409 slot_unavailable\n    422 invalid input\n\nPOST /api/v1/appointments/{id}/cancel\n    200/404\n\nGET /api/v1/appointments/{id} -> Appointment\n    200/404\n\nGET /api/v1/dealerships/{id}/availability\n        ?service_type_id=..&date=..\n    200 [ {start, end} ]\n\nGET /api/v1/dealerships/{id}/events (SSE)\n    event: booked | cancelled\n\nAppointment = { id, customer_id, vehicle_id, dealership_id,\n    service_type_id, bay_id, technician_id, start, end\n    status }\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/v1/appointments -> Appointment\n    Header Idempotency-Key\n    Body { customer_id, vehicle_id, dealership_id,\n            service_type_id, time }\n    201 new\n    200 replay\n    409 slot_unavailable\n    422 invalid input\n\nPOST /api/v1/appointments/{id}/cancel\n    200/404\n\nGET /api/v1/appointments/{id} -> Appointment\n    200/404\n\nGET /api/v1/dealerships/{id}/availability\n        ?service_type_id=..&date=..\n    200 [ {start, end} ]\n\nGET /api/v1/dealerships/{id}/events (SSE)\n    event: booked | cancelled\n\nAppointment = { id, customer_id, vehicle_id, dealership_id,\n    service_type_id, bay_id, technician_id, start, end\n    status }\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
