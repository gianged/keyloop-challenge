      "link": null,
      "locked": false,
      "text": "3. Confirmed Appointment Record: Upon success,\ncreate a persistent. Appointment record\nassociating the customer, vehicle, technician, and\nservice bay",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Confirmed Appointment Record: Upon success, create a persistent. Appointment record associating the customer, vehicle, technician, and service bay",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
