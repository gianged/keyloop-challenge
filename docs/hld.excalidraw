    {
      "id": "GLwB3ds0rahF4Qq7dkIJi",
      "type": "text",
      "x": 465.73333740234375,
      "y": -307.5,
      "width": 463.199951171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TFiPsNyGBnnkSgLwEIgGE"
      ],
      "frameId": null,
      "index": "a1V",
      "roundness": null,
      "seed": 792954313,
      "version": 402,
      "versionNonce": 151604541,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793347134845,
      "created": 1793267795807,
      "link": null,
      "locked": false,
      "text": "1. Resource Constrained Booking: Allow a user\nto request a service appointment for a specific\nvehicle, service type, and dealership at a\ndesired time.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Resource Constrained Booking: Allow a user to request a service appointment for a specific vehicle, service type, and dealership at a desired time.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cxVWD-Won9hugM2A18HJp",
      "type": "text",
      "x": 466.73333740234375,
      "y": -200.5,
      "width": 466.9999999999999,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TFiPsNyGBnnkSgLwEIgGE"
      ],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1711370631,
      "version": 426,
      "versionNonce": 742825373,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793347134845,
      "created": 1793267795807,
      "link": null,
      "locked": false,
      "text": "2. Real-Time Availability Check: Before\nconfirming, check for the availability of both a\nServiceBay and a qualified Technician for the\nentire service duration.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Real-Time Availability Check: Before confirming, check for the availability of both a ServiceBay and a qualified Technician for the entire service duration.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Orm_GXpZi1clWV6tZcjV3",
