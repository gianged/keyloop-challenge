      "seed": 59995399,
      "version": 1045,
      "versionNonce": 449116973,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532383662,
      "created": 1793268388027,
      "link": null,
      "locked": false,
      "text": "Non-functional Requirements:\n- Consistency > Availability\n- P95 (<200ms) for booking response\n- Correctness (must satisfy the availability on booking)\n- Real-time update",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional Requirements:\n- Consistency > Availability\n- P95 (<200ms) for booking response\n- Correctness (must satisfy the availability on booking)\n- Real-time update",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
